<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Build</RootNamespace>
        <NoWarn>NU1608;NU1901;NU1904</NoWarn>
        <!-- The build CLI is infrastructure; it is never shipped. -->
        <IsPackable>false</IsPackable>
        <IsTrimmable>true</IsTrimmable>
        <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Build\Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Bump the F# SDK's implicit FSharp.Core reference to the highest
             version anything here asks for: Partas.GitNet 3.0.0 wants
             >= 10.0.102 and the Partas.Build project reference brings
             10.1.400, and without this NU1605 reports the downgrade.
             `Update` modifies the existing implicit reference instead of
             adding a duplicate (which would trigger NU1504). -->
        <PackageReference Update="FSharp.Core" Version="10.1.400"/>
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0"/>
        <PackageReference Include="Partas.GitNet" Version="3.0.0"/>
        <PackageReference Include="Partas.TypeProvider.BuildHelper" Version="0.2.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- The build CLI is the library's acceptance test: it is written against Partas.Build. -->
        <ProjectReference Include="src\Partas.Build.Baked\Partas.Build.Baked.fsproj" />
        <ProjectReference Include="src\Partas.Build\Partas.Build.fsproj"/>
    </ItemGroup>

</Project>
