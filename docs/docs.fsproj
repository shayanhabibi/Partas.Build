<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Directives.fs" />
        <Compile Include="Site.fs" />
        <None Include="static/**/*.*"/>
        <None Include="content/**/*.*"/>
        <None Include="blog/**/*.*" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Nacara.Core" Version="2.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Changelog" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.Deploy.GitHubPages" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.FSharpApi" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Highlight.TreeSitter" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.LinkValidator" Version="1.0.0-beta.2" />
        <PackageReference Include="Nacara.Plugin.Literate" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.LiveExample" Version="1.0.0-beta.4" />
        <PackageReference Include="Nacara.Plugin.Markdown" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Highlight.TextMate" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Search" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Sitemap" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Assets.LightningCss" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Assets.Nuglify" Version="1.0.0-*" />
        <PackageReference Include="Nacara.Plugin.Versions" Version="1.0.0-beta.1" />
        <PackageReference Include="Nacara.Plugin.Assets.Esbuild" Version="1.0.0-*" />
        <!-- The published Partas.Nacara plugins require FSharp.Core 11. This is docs-only. -->
        <PackageReference Include="FSharp.Core" Version="11.0.101-rc1.26425.128" />
        <PackageReference Include="Partas.Nacara.Theme" Version="0.2.0" />
        <PackageReference Include="Partas.Nacara.Plugins.AgentFriendly" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.Directives" Version="0.1.0" />
        <PackageReference Include="Partas.Nacara.Plugins.OgImage" Version="0.1.0" />
    </ItemGroup>
</Project>
