<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Partas.Build</RootNamespace>
        <AssemblyName>Partas.Build</AssemblyName>
        <PackageId>Partas.Build</PackageId>
        <Title>Partas.Build</Title>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- Owned by `dotnet run bump`; CI packs whatever this says. -->
        <Version>0.6.5</Version>
        <AssemblyVersion>0.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="System.CommandLine\Aliases.fs" />
        <Compile Include="System.CommandLine\Inputs.fs" />
        <Compile Include="Exceptions.fs" />
        <Compile Include="Output.fs" />
        <Compile Include="Terminal.fs" />
        <Compile Include="Environment.fs" />
        <Compile Include="Timing.fs" />
        <Compile Include="Producer.fs" />
        <Compile Include="Failures.fs" />
        <Compile Include="Conductors.fs" />
        <Compile Include="Conductors.Runners.fs" />
        <Compile Include="Process.fs" />
        <Compile Include="Operations.fs" />
        <Compile Include="Dependencies.fs" />
        <Compile Include="DependencyPlan.fs" />
        <Compile Include="ExecutionState.fs" />
        <Compile Include="Builders\StageSettings.fs" />
        <Compile Include="Builders\Stage.fs" />
        <Compile Include="Builders\Conditions.fs" />
        <Compile Include="Builders\PipelineSettings.fs" />
        <Compile Include="Builders\Pipeline.fs" />
        <Compile Include="Builders\Inputs.fs" />
        <Compile Include="Builders\Dependencies.fs" />
        <Compile Include="MachineOutput.fs" />
        <Compile Include="Explain.fs" />
        <Compile Include="Summary.fs" />
        <Compile Include="RunResult.fs" />
        <Compile Include="Builders\Command.fs" />
        <None Include="../../README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!--
    Shared XML doc fragments spliced into the builders at compile time by the `<include>` tag (FS-1341).
    Listed here so they are tracked compilation inputs: editing a fragment must invalidate the up-to-date check,
    otherwise the generated Partas.Build.xml keeps the stale text. `<include>` is expanded only on the doc writer path,
    and only by an F# 11 compiler — on older toolchains the tag is passed through verbatim, so the
    shared remarks go missing while every inline summary still renders.
    -->
    <ItemGroup>
        <None Include="xmldoc/*.xml" />
        <UpToDateCheckInput Include="xmldoc/*.xml" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FSharp.Control.AsyncSeq" Version="4.15.0" />
      <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
      <PackageReference Include="System.CommandLine" Version="2.0.11" />
    </ItemGroup>

    <!-- System.Text.Json is part of the shared framework on net8.0 and later. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
      <PackageReference Include="System.Text.Json" Version="8.0.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Partas.Build.Cmd\Partas.Build.Cmd.fsproj" />
    </ItemGroup>

</Project>
