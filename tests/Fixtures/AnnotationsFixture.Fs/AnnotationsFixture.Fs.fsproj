<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The F#-shaped half of the fixture: the mangled optional-type-extension setter is the site
    Partas.Solid has 596 of, and is the reason this generator exists. Kept separate from the C#
    fixture so a count assertion over one is not perturbed by an edit to the other.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>AnnotationsFixture.Fs</AssemblyName>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- JetBrains' attributes are [Conditional("JETBRAINS_ANNOTATIONS")]; without this they
             compile away and never reach metadata, so nothing would be there to find. -->
        <DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Surface.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0"/>
    </ItemGroup>

</Project>
