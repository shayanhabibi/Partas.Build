<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A consumer of the published library surface, compiled outside the library's own assembly. What it proves is
    the annotations: an inline custom operation that dispatches through SRTP resolves here only when every helper
    it names is public, and a `Build*` alias applied by an inline member fails in Release alone (FS1118).
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="PipelineProbe.fs"/>
        <Compile Include="Probe.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Partas.Build\Partas.Build.fsproj"/>
    </ItemGroup>

</Project>
