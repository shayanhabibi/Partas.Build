<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <!--
        Linked rather than copied: the option-registering `parse` is the one place a test can
        register an input, and two copies of it would let the two suites disagree about what that
        means.
        -->
        <Compile Include="..\Partas.Build.Tests\Helpers.fs" Link="BuildHelpers.fs"/>
        <Compile Include="Helpers.fs"/>
        <Compile Include="OptionsTests.fs"/>
        <Compile Include="GenerateTests.fs"/>
        <Compile Include="VerifyTests.fs"/>
        <Compile Include="InitTests.fs"/>
        <Compile Include="CommandTests.fs"/>
        <Compile Include="PackTests.fs"/>
        <Compile Include="Main.fs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8"/>
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2"/>
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Partas.Build.ExternalAnnotations\Partas.Build.ExternalAnnotations.fsproj"/>
        <!-- The tool is nothing but the three commands; referencing it asserts that stays true. -->
        <ProjectReference Include="..\..\Partas.ExternalAnnotations.Tool\Partas.ExternalAnnotations.Tool.fsproj"/>
        <ProjectReference Include="..\Fixtures\AnnotationsFixture.Cs\AnnotationsFixture.Cs.csproj"/>
    </ItemGroup>

</Project>
